import heapq
import random
import math
import statistics
from collections import deque


# ============================================================
# Network configuration
# ============================================================

HUB_NAMES = ["VUSA", "UK hub", "UAE hub", "Virtual hub"]

# Share of total customer demand per base location.
DEMAND_SHARE = [0.7991, 0.0800, 0.0500, 0.0709]

# Regular replenishment lead time depot -> hub (days)
REGULAR_LEAD_TIME = [49.0, 3.0, 49.0, 0.25]

# Emergency shipment lead time (days)
EMERGENCY_LEAD_TIME = [4.0, 1.0, 4.0, 0.25]

# Total demand rate across all hubs (parts/day)
LAMBDA_TOTAL = 0.5

# Supplier -> depot lead time (days)
DEPOT_LEAD_TIME = 30.0

# Base-stock levels at hubs (used by BOTH simulation and analytical model)
DEFAULT_BASE_STOCK = [10, 1, 2, 4]

if not math.isclose(sum(DEMAND_SHARE), 1.0, rel_tol=1e-9, abs_tol=1e-9):
    raise ValueError("DEMAND_SHARE must sum to 1.0.")


# ============================================================
# Poisson / Erlang helpers
# ============================================================

def poisson_cdf(k, mu):
    """P(X <= k) for X ~ Poisson(mu)."""
    if k < 0:
        return 0.0
    if mu <= 0:
        return 1.0
    p = math.exp(-mu)
    total = p
    for n in range(1, k + 1):
        p *= mu / n
        total += p
    return min(total, 1.0)


def expected_backorders(mu, s):
    """E[(X - s)+] for X ~ Poisson(mu)."""
    if mu <= 0:
        return 0.0
    if s < 0:
        return mu - s
    max_n = int(mu + 10 * math.sqrt(max(mu, 0.0)) + 100)
    p = math.exp(-mu)
    total = 0.0
    for n in range(1, max_n + 1):
        p *= mu / n
        if n > s:
            total += (n - s) * p
    return total


def erlang_loss(servers, offered_load):
    """Erlang-B blocking probability (= P(hub has zero units on hand))."""
    if servers <= 0:
        return 1.0
    if offered_load <= 0:
        return 0.0
    b = 1.0
    for n in range(1, servers + 1):
        b = offered_load * b / (n + offered_load * b)
    return b


# ============================================================
# Event types
# ============================================================

_DEMAND = 0
_REGULAR_ARRIVAL = 1
_DEPOT_REPLENISH = 2


# ============================================================
# Simulation
# ============================================================

def run_simulation(
    mean_demand,
    lead_time_L,
    base_stock_s,
    lead_time_L0,
    base_stock_s0,
    sim_duration=20_000.0,
    warmup=2_000.0,
    seed=42,
):
    rng = random.Random(seed)
    J = len(mean_demand)

    if not (len(lead_time_L) == len(base_stock_s) == J):
        raise ValueError("All base parameter lists must have the same length.")
    if any(rate <= 0 for rate in mean_demand):
        raise ValueError("All demand rates must be positive.")
    if warmup >= sim_duration:
        raise ValueError("warmup must be smaller than sim_duration.")

    # ---------------- State ----------------
    depot_on_hand = base_stock_s0
    depot_backorders = deque()          # hubs waiting for a depot unit
    hub_on_hand = list(base_stock_s)
    regular_in_transit = 0

    # ---------------- Demand counters ----------------
    demand_total = [0] * J
    local_fills = [0] * J
    emergency_depot = [0] * J
    emergency_external = [0] * J
    hub_empty_at_demand = [0] * J
    depot_up_at_demand = [0] * J
    joint_at_demand = [0] * J

    # ---------------- Depot counters ----------------
    depot_regular_requests = 0
    depot_regular_filled = 0
    depot_backorder_requests = 0
    supplier_orders = 0

    # ---------------- Time averages ----------------
    hub_empty_time = [0.0] * J
    joint_time = [0.0] * J
    depot_up_time = 0.0
    regular_in_transit_area = 0.0
    depot_backorder_area = 0.0
    last_time = 0.0

    # ---------------- Event queue ----------------
    event_queue = []
    sequence_number = 0

    def schedule(time, kind, hub):
        nonlocal sequence_number
        sequence_number += 1
        heapq.heappush(event_queue, (time, sequence_number, kind, hub))

    # Generate demand events
    for j in range(J):
        t = rng.expovariate(mean_demand[j])
        while t <= sim_duration:
            schedule(t, _DEMAND, j)
            t += rng.expovariate(mean_demand[j])

    # ---------------- Time accumulation ----------------
    def accumulate(time):
        nonlocal last_time, depot_backorder_area, depot_up_time
        nonlocal regular_in_transit_area

        start = max(last_time, warmup)
        if time > start:
            dt = time - start
            depot_backorder_area += len(depot_backorders) * dt
            if depot_on_hand > 0:
                depot_up_time += dt
            regular_in_transit_area += regular_in_transit * dt
            for j in range(J):
                if hub_on_hand[j] == 0:
                    hub_empty_time[j] += dt
                    if depot_on_hand > 0:
                        joint_time[j] += dt
        last_time = time

    # ---------------- Main event loop ----------------
    while event_queue:
        time, _, kind, j = heapq.heappop(event_queue)
        if time > sim_duration:
            break

        accumulate(time)
        active = time >= warmup

        # ---------- CUSTOMER DEMAND ----------
        if kind == _DEMAND:
            depot_up = depot_on_hand > 0
            hub_empty = hub_on_hand[j] == 0

            if active:
                demand_total[j] += 1
                if depot_up:
                    depot_up_at_demand[j] += 1
                if hub_empty:
                    hub_empty_at_demand[j] += 1
                    if depot_up:
                        joint_at_demand[j] += 1

            if not hub_empty:
                # CASE 1: hub serves customer locally
                hub_on_hand[j] -= 1
                if active:
                    local_fills[j] += 1

                depot_regular_requests += 1  # (note: also counts warmup)
                if depot_on_hand > 0:
                    if active:
                        depot_regular_filled += 1
                    depot_on_hand -= 1
                    regular_in_transit += 1
                    schedule(time + lead_time_L[j], _REGULAR_ARRIVAL, j)
                else:
                    depot_backorders.append(j)
                    if active:
                        depot_backorder_requests += 1

                supplier_orders += 1
                schedule(time + lead_time_L0, _DEPOT_REPLENISH, -1)

            elif depot_up:
                # CASE 2: hub empty, depot has stock -> emergency from depot
                if active:
                    emergency_depot[j] += 1
                depot_on_hand -= 1
                supplier_orders += 1
                schedule(time + lead_time_L0, _DEPOT_REPLENISH, -1)

            else:
                # CASE 3: hub empty, depot empty -> external emergency
                if active:
                    emergency_external[j] += 1

        # ---------- REGULAR HUB ARRIVAL ----------
        elif kind == _REGULAR_ARRIVAL:
            hub_on_hand[j] += 1
            regular_in_transit -= 1

        # ---------- DEPOT REPLENISHMENT ----------
        elif kind == _DEPOT_REPLENISH:
            if depot_backorders:
                waiting_hub = depot_backorders.popleft()
                regular_in_transit += 1
                schedule(time + lead_time_L[waiting_hub], _REGULAR_ARRIVAL, waiting_hub)
            else:
                depot_on_hand += 1

        else:
            raise ValueError(f"Unknown event kind: {kind}")

    accumulate(sim_duration)
    effective_time = sim_duration - warmup

    def per_demand(counter):
        return [counter[j] / max(demand_total[j], 1) for j in range(J)]

    p_hub_empty_time = [hub_empty_time[j] / effective_time for j in range(J)]
    p_depot_up_time = depot_up_time / effective_time
    p_joint_time = [joint_time[j] / effective_time for j in range(J)]

    p_hub_empty_demand = per_demand(hub_empty_at_demand)
    p_depot_up_demand = per_demand(depot_up_at_demand)
    p_joint_demand = per_demand(joint_at_demand)

    return {
        "beta_sim": per_demand(local_fills),
        "theta_sim": per_demand(emergency_depot),
        "gamma_sim": per_demand(emergency_external),
        "p_hub_empty_demand": p_hub_empty_demand,
        "p_depot_up_demand": p_depot_up_demand,
        "p_joint_demand": p_joint_demand,
        "p_hub_empty_time": p_hub_empty_time,
        "p_depot_up_time": [p_depot_up_time] * J,
        "p_joint_time": p_joint_time,
        "ebo_depot": depot_backorder_area / effective_time,
        "regular_in_transit_avg": regular_in_transit_area / effective_time,
        "demand_total": demand_total,
    }


# ============================================================
# Replications
# ============================================================

def run_replications(n_reps=8, base_seed=1000, **kwargs):
    reps = [run_simulation(seed=base_seed + r, **kwargs) for r in range(n_reps)]
    J = len(reps[0]["beta_sim"])

    scalar_keys = ["ebo_depot", "regular_in_transit_avg"]
    vector_keys = [k for k in reps[0] if k not in scalar_keys]

    output = {k: statistics.mean(r[k] for r in reps) for k in scalar_keys}
    for k in vector_keys:
        output[k] = [statistics.mean(r[k][j] for r in reps) for j in range(J)]

    # 95% CI half-width for theta
    output["theta_halfwidth"] = []
    for j in range(J):
        values = [r["theta_sim"][j] for r in reps]
        hw = (1.96 * statistics.stdev(values) / math.sqrt(len(values))
              if len(values) > 1 else 0.0)
        output["theta_halfwidth"].append(hw)

    return output


# ============================================================
# Analytical approximation
# ============================================================

def supervisor_analytical(
    local_base_stock,
    s0,
    lambda_local,
    depot_lead_time,
    local_lead_time,
    other_bases=None,
    max_iter=500,
    tol=1e-10,
):
    """
    Independence approximation:

        theta = P(hub empty) * P(depot available)

    Fixed point over:
      - total depot withdrawal rate (regular + emergency)
      - depot waiting time (which lengthens hub replenishment time)
    """
    all_bases = [{"lambda": lambda_local, "L": local_lead_time, "S": local_base_stock}]
    all_bases.extend(other_bases or [])

    depot_wait = 0.0
    lambda_depot = sum(b["lambda"] for b in all_bases)

    for _ in range(max_iter):
        mu_depot = lambda_depot * depot_lead_time
        depot_fill_rate = poisson_cdf(s0 - 1, mu_depot)
        depot_ebo = expected_backorders(mu_depot, s0)

        regular_rate = 0.0
        emergency_rate = 0.0
        for base in all_bases:
            offered_load = base["lambda"] * (base["L"] + depot_wait)
            p_empty = erlang_loss(base["S"], offered_load)
            regular_rate += base["lambda"] * (1.0 - p_empty)
            emergency_rate += base["lambda"] * p_empty * depot_fill_rate

        new_lambda_depot = regular_rate + emergency_rate
        regular_backorder_rate = regular_rate * (1.0 - depot_fill_rate)
        new_depot_wait = (depot_ebo / regular_backorder_rate
                          if regular_backorder_rate > 0 else 0.0)

        difference = max(abs(new_lambda_depot - lambda_depot),
                         abs(new_depot_wait - depot_wait))
        lambda_depot = new_lambda_depot
        depot_wait = new_depot_wait
        if difference < tol:
            break

    mu_depot = lambda_depot * depot_lead_time
    depot_fill_rate = poisson_cdf(s0 - 1, mu_depot)
    depot_ebo = expected_backorders(mu_depot, s0)

    offered_load = lambda_local * (local_lead_time + depot_wait)
    p_hub_empty = erlang_loss(local_base_stock, offered_load)

    return {
        "lambda_depot": lambda_depot,
        "depot_fill_rate": depot_fill_rate,
        "depot_ebo": depot_ebo,
        "depot_wait": depot_wait,
        "offered_load": offered_load,
        "p_hub_empty": p_hub_empty,
        "hub_fill_rate": 1.0 - p_hub_empty,
        "theta_analytical": p_hub_empty * depot_fill_rate,
    }


# ============================================================
# Comparison
# ============================================================

def compare_simulation_with_supervisor(hub=0):
    mean_demand = [LAMBDA_TOTAL * share for share in DEMAND_SHARE]
    base_stock = list(DEFAULT_BASE_STOCK)

    other_bases = [
        {"lambda": mean_demand[k], "L": REGULAR_LEAD_TIME[k], "S": base_stock[k]}
        for k in range(len(HUB_NAMES))
        if k != hub
    ]

    parameters = {
        "mean_demand": mean_demand,
        "lead_time_L": REGULAR_LEAD_TIME,
        "base_stock_s": base_stock,
        "lead_time_L0": DEPOT_LEAD_TIME,
        "sim_duration": 20_000.0,
        "warmup": 2_000.0,
    }

    # Depot pipeline mean is roughly lambda_total * L0 = 15,
    # so 5-30 covers both heavy and light depot stockouts.
    s0_values = [5, 8, 11, 14, 17, 21, 26, 30]

    width = 190
    print("\n" + "=" * width)
    print(
        f"{HUB_NAMES[hub]}"
        f" | share = {DEMAND_SHARE[hub]:.2%}"
        f" | lambda_j = {mean_demand[hub]:.5f}/day"
        f" | L_j = {REGULAR_LEAD_TIME[hub]:.2f} d"
        f" | S_j = {base_stock[hub]}"
        f" | lambda_total = {LAMBDA_TOTAL:.4f}/day"
    )
    print("=" * width)
    print(
        f"{'s0':>4}{'FR dp A':>9}{'FR dp S':>9}{'FR hub A':>10}{'FR hub S':>10}"
        f"{'P(H=0)':>9}{'P(D>0)':>9}{'Product':>10}{'Joint':>10}{'Prod/Jnt':>10}"
        f"{'Theta A':>10}{'Theta S':>10}{'Err %':>9}{'Corr %':>9}"
    )
    print("-" * width)

    for s0 in s0_values:
        # Analytical model: SAME hub stock as the simulation
        analytical = supervisor_analytical(
            local_base_stock=base_stock[hub],
            s0=s0,
            lambda_local=mean_demand[hub],
            depot_lead_time=DEPOT_LEAD_TIME,
            local_lead_time=REGULAR_LEAD_TIME[hub],
            other_bases=other_bases,
        )

        simulation = run_replications(
            n_reps=8,
            base_seed=1000,
            **{**parameters, "base_stock_s0": s0},
        )

        depot_fill_analytical = analytical["depot_fill_rate"]
        depot_fill_sim = simulation["p_depot_up_time"][0]

        hub_fill_analytical = analytical["hub_fill_rate"]
        hub_fill_sim = simulation["beta_sim"][hub]

        p_hub_empty = simulation["p_hub_empty_demand"][hub]
        p_depot_up = simulation["p_depot_up_demand"][hub]
        product = p_hub_empty * p_depot_up
        joint = simulation["p_joint_demand"][hub]

        ratio = product / joint if joint > 0 else float("nan")

        theta_a = analytical["theta_analytical"]
        theta_s = simulation["theta_sim"][hub]

        error_total = 100.0 * abs(theta_a - theta_s) / theta_s if theta_s > 0 else 0.0
        error_corr = 100.0 * abs(product - joint) / joint if joint > 0 else 0.0

        print(
            f"{s0:>4}"
            f"{depot_fill_analytical:>9.4f}"
            f"{depot_fill_sim:>9.4f}"
            f"{hub_fill_analytical:>10.4f}"
            f"{hub_fill_sim:>10.4f}"
            f"{p_hub_empty:>9.6f}"
            f"{p_depot_up:>9.4f}"
            f"{product:>10.6f}"
            f"{joint:>10.6f}"
            f"{ratio:>10.3f}"
            f"{theta_a:>10.6f}"
            f"{theta_s:>10.6f}"
            f"{error_total:>8.2f}%"
            f"{error_corr:>8.2f}%"
        )


# ============================================================
# Main
# ============================================================

if __name__ == "__main__":
    # hub = 0 -> VUSA, 1 -> UK, 2 -> UAE, 3 -> Virtual hub
    compare_simulation_with_supervisor(hub=0)






