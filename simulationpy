def depot_fill_rate_sQ(mu, s, Q):
    """Depot fill rate under an (s,Q) policy with unit-sized Poisson demand."""
    if Q <= 0:
        raise ValueError("Q must be strictly positive.")
    return sum(poisson_cdf(s + n - 1, mu) for n in range(1, Q + 1)) / Q


def depot_ebo_sQ(mu, s, Q):
    """Depot EBO averaged over the Q possible inventory positions."""
    if Q <= 0:
        raise ValueError("Q must be strictly positive.")
    return sum(expected_backorders(mu, s + n) for n in range(1, Q + 1)) / Q

