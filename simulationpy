def erlang_loss(servers, offered_load):
    """
    Erlang-B blocking probability.

    In this model this is used as the probability that the
    hub has zero units on hand.
    """

    if servers <= 0:
        return 1.0

    if offered_load <= 0:
        return 0.0

    b = 1.0

    for n in range(1, servers + 1):
        b = (
            offered_load * b
            / (n + offered_load * b)
        )

    return b


