import heapq
import random
import math
import statistics
from collections import deque


# ============================================================
# Poisson functions
# ============================================================

def poisson_cdf(k, mu):
    """P(X <= k) for X ~ Poisson(mu)."""
    if k < 0:
        return 0.0

    p = math.exp(-mu)
    total = p

    for n in range(1, k + 1):
        p *= mu / n
        total += p

    return min(total, 1.0)


def expected_backorders(mu, s):
    """Expected backorders E[(X-s)+] for X ~ Poisson(mu)."""
    max_n = int(mu + 10 * math.sqrt(max(mu, 0.0)) + 100)

    p = math.exp(-mu)
    total = 0.0

    for n in range(1, max_n + 1):
        p *= mu / n

        if n > s:
            total += (n - s) * p

    return total


# ============================================================
# Simulation model
# ============================================================

def run_simulation(
    mean_demand,
    lead_time_L,
    base_stock_s,
    emerg_time,
    lead_time_L0,
    base_stock_s0,
    sim_duration=100_000,
    warmup=50_000,
    seed=42,
):
    """
    One item stored at one depot and multiple regional hubs.

    Policy:
    - Each hub uses an (S-1, S) base-stock policy.
    - The depot uses an (S-1, S) base-stock policy.
    - If the hub has stock, demand is served locally and one unit is
      requested from the depot.
    - If the hub is empty and the depot has stock, demand is served by
      emergency shipment directly from the depot.
    - If both locations are empty, demand becomes a local backorder and
      a regular request is placed at the depot.
    """

    rng = random.Random(seed)

    number_of_hubs = len(mean_demand)

    if not (
        len(lead_time_L)
        == len(base_stock_s)
        == len(emerg_time)
        == number_of_hubs
    ):
        raise ValueError(
            "mean_demand, lead_time_L, base_stock_s and emerg_time "
            "must have the same length."
        )

    if any(rate <= 0 for rate in mean_demand):
        raise ValueError("All demand rates must be positive.")

    # --------------------------------------------------------
    # Inventory state
    # --------------------------------------------------------

    depot_on_hand = base_stock_s0
    depot_backorder_queue = deque()

    hub_on_hand = list(base_stock_s)
    hub_backorders = [0] * number_of_hubs

    # --------------------------------------------------------
    # Demand-epoch counters
    # --------------------------------------------------------

    demand_total = [0] * number_of_hubs

    local_fills = [0] * number_of_hubs
    emergency_shipments = [0] * number_of_hubs
    customer_backorders = [0] * number_of_hubs

    hub_stockout_demands = [0] * number_of_hubs

    # Depot state observed at all customer-demand epochs
    depot_available_demands = [0] * number_of_hubs

    # Joint event:
    # hub empty and depot available
    joint_emergency_opportunities = [0] * number_of_hubs

    # Depot availability conditional on hub stockout
    depot_available_given_hub_stockout = [0] * number_of_hubs

    # Depot request counters
    depot_requests = 0
    depot_requests_filled = 0

    # --------------------------------------------------------
    # Time-average backorders
    # --------------------------------------------------------

    hub_backorder_area = [0.0] * number_of_hubs
    depot_backorder_area = 0.0

    last_time = 0.0

    # --------------------------------------------------------
    # Event list
    # --------------------------------------------------------

    event_queue = []
    sequence_number = 0

    def schedule(time, event_type, data=None):
        nonlocal sequence_number

        sequence_number += 1

        heapq.heappush(
            event_queue,
            (
                time,
                sequence_number,
                event_type,
                data if data is not None else {},
            ),
        )

    def accumulate_statistics(time):
        nonlocal last_time, depot_backorder_area

        start = max(last_time, warmup)

        if time > start:
            duration = time - start

            for j in range(number_of_hubs):
                hub_backorder_area[j] += hub_backorders[j] * duration

            depot_backorder_area += (
                len(depot_backorder_queue) * duration
            )

        last_time = time

    def order_from_supplier(time):
        schedule(
            time + lead_time_L0,
            "DEPOT_REPLENISHMENT",
        )

    def request_regular_replenishment(j, time, active):
        """
        A hub requests one regular replenishment unit from the depot.
        """

        nonlocal depot_on_hand
        nonlocal depot_requests
        nonlocal depot_requests_filled

        if active:
            depot_requests += 1

        if depot_on_hand > 0:
            if active:
                depot_requests_filled += 1

            depot_on_hand -= 1

            schedule(
                time + lead_time_L[j],
                "HUB_REPLENISHMENT",
                {"hub": j},
            )

        else:
            depot_backorder_queue.append(j)

        # Every depot demand generates one supplier order.
        order_from_supplier(time)

    # --------------------------------------------------------
    # Initial demand events
    # --------------------------------------------------------

    for j, demand_rate in enumerate(mean_demand):
        schedule(
            rng.expovariate(demand_rate),
            "CUSTOMER_DEMAND",
            {"hub": j},
        )

    current_time = 0.0

    # --------------------------------------------------------
    # Main simulation loop
    # --------------------------------------------------------

    while event_queue:
        time, _, event_type, data = heapq.heappop(event_queue)

        if time > sim_duration:
            accumulate_statistics(sim_duration)
            current_time = sim_duration
            break

        accumulate_statistics(time)

        current_time = time
        active = time >= warmup

        # ====================================================
        # Customer demand
        # ====================================================

        if event_type == "CUSTOMER_DEMAND":
            j = data["hub"]

            schedule(
                time + rng.expovariate(mean_demand[j]),
                "CUSTOMER_DEMAND",
                {"hub": j},
            )

            if active:
                demand_total[j] += 1

                if depot_on_hand > 0:
                    depot_available_demands[j] += 1

            # ------------------------------------------------
            # Case 1: hub has stock
            # ------------------------------------------------

            if hub_on_hand[j] > 0:
                hub_on_hand[j] -= 1

                if active:
                    local_fills[j] += 1

                request_regular_replenishment(
                    j=j,
                    time=time,
                    active=active,
                )

            # ------------------------------------------------
            # Case 2: hub is out of stock
            # ------------------------------------------------

            else:
                if active:
                    hub_stockout_demands[j] += 1

                # --------------------------------------------
                # Depot has stock: emergency shipment
                # --------------------------------------------

                if depot_on_hand > 0:
                    if active:
                        emergency_shipments[j] += 1
                        joint_emergency_opportunities[j] += 1
                        depot_available_given_hub_stockout[j] += 1

                    depot_on_hand -= 1

                    schedule(
                        time + emerg_time[j],
                        "EMERGENCY_ARRIVAL",
                        {"hub": j},
                    )

                    # The emergency unit is the unit consumed
                    # from the depot for this demand.
                    # Therefore only one supplier order is placed.
                    order_from_supplier(time)

                # --------------------------------------------
                # Depot is also empty: customer backorder
                # --------------------------------------------

                else:
                    hub_backorders[j] += 1

                    if active:
                        customer_backorders[j] += 1

                    request_regular_replenishment(
                        j=j,
                        time=time,
                        active=active,
                    )

        # ====================================================
        # Regular replenishment arrives at hub
        # ====================================================

        elif event_type == "HUB_REPLENISHMENT":
            j = data["hub"]

            if hub_backorders[j] > 0:
                hub_backorders[j] -= 1
            else:
                hub_on_hand[j] += 1

        # ====================================================
        # Supplier replenishment arrives at depot
        # ====================================================

        elif event_type == "DEPOT_REPLENISHMENT":
            if depot_backorder_queue:
                waiting_hub = depot_backorder_queue.popleft()

                schedule(
                    time + lead_time_L[waiting_hub],
                    "HUB_REPLENISHMENT",
                    {"hub": waiting_hub},
                )
            else:
                depot_on_hand += 1

        # ====================================================
        # Emergency unit reaches customer
        # ====================================================

        elif event_type == "EMERGENCY_ARRIVAL":
            # Customer was already classified as emergency-served
            # when the shipment was initiated.
            pass

        else:
            raise ValueError(f"Unknown event type: {event_type}")

    effective_time = max(current_time - warmup, 1e-9)

    # --------------------------------------------------------
    # Performance measures
    # --------------------------------------------------------

    shelf_fill_rate = [
        local_fills[j] / max(demand_total[j], 1)
        for j in range(number_of_hubs)
    ]

    hub_stockout_fraction = [
        hub_stockout_demands[j] / max(demand_total[j], 1)
        for j in range(number_of_hubs)
    ]

    theta_sim = [
        emergency_shipments[j] / max(demand_total[j], 1)
        for j in range(number_of_hubs)
    ]

    service_fill_rate = [
        (
            local_fills[j]
            + emergency_shipments[j]
        )
        / max(demand_total[j], 1)
        for j in range(number_of_hubs)
    ]

    depot_availability_at_demand = [
        depot_available_demands[j] / max(demand_total[j], 1)
        for j in range(number_of_hubs)
    ]

    conditional_depot_availability = [
        (
            depot_available_given_hub_stockout[j]
            / hub_stockout_demands[j]
            if hub_stockout_demands[j] > 0
            else 0.0
        )
        for j in range(number_of_hubs)
    ]

    # Independence approximation using simulation probabilities
    theta_independence_sim = [
        hub_stockout_fraction[j]
        * depot_availability_at_demand[j]
        for j in range(number_of_hubs)
    ]

    depot_request_fill_rate = (
        depot_requests_filled / max(depot_requests, 1)
    )

    return {
        "shelf_fill_rate": shelf_fill_rate,
        "service_fill_rate": service_fill_rate,
        "hub_stockout_fraction": hub_stockout_fraction,
        "theta_sim": theta_sim,
        "theta_independence_sim": theta_independence_sim,
        "depot_availability_at_demand": depot_availability_at_demand,
        "conditional_depot_availability": (
            conditional_depot_availability
        ),
        "exp_bo_local": [
            hub_backorder_area[j] / effective_time
            for j in range(number_of_hubs)
        ],
        "exp_bo_depot": (
            depot_backorder_area / effective_time
        ),
        "depot_request_fill_rate": depot_request_fill_rate,
        "demand_total": demand_total,
        "customer_backorders": customer_backorders,
    }


# ============================================================
# Replications
# ============================================================

def run_replications(n_reps=20, base_seed=1000, **kwargs):
    replications = [
        run_simulation(
            seed=base_seed + replication,
            **kwargs,
        )
        for replication in range(n_reps)
    ]

    number_of_hubs = len(
        replications[0]["shelf_fill_rate"]
    )

    output = {}

    scalar_keys = [
        "exp_bo_depot",
        "depot_request_fill_rate",
    ]

    vector_keys = [
        "shelf_fill_rate",
        "service_fill_rate",
        "hub_stockout_fraction",
        "theta_sim",
        "theta_independence_sim",
        "depot_availability_at_demand",
        "conditional_depot_availability",
        "exp_bo_local",
        "demand_total",
        "customer_backorders",
    ]

    for key in scalar_keys:
        output[key] = statistics.mean(
            replication[key]
            for replication in replications
        )

    for key in vector_keys:
        output[key] = [
            statistics.mean(
                replication[key][j]
                for replication in replications
            )
            for j in range(number_of_hubs)
        ]

    return output


# ============================================================
# Analytical approximation
# ============================================================

def supervisor_analytical(
    local_base_stock,
    s0,
    lambda_total=6.5,
    lambda_local=2.0,
    depot_lead_time=5.0,
    local_lead_time=2.0,
):
    mu_depot = lambda_total * depot_lead_time

    depot_ebo = expected_backorders(
        mu=mu_depot,
        s=s0,
    )

    depot_waiting_time = depot_ebo / lambda_total

    mu_local = lambda_local * (
        local_lead_time + depot_waiting_time
    )

    hub_fill_rate = poisson_cdf(
        local_base_stock - 1,
        mu_local,
    )

    local_ebo = expected_backorders(
        mu=mu_local,
        s=local_base_stock,
    )

    depot_fill_rate = poisson_cdf(
        s0 - 1,
        mu_depot,
    )

    theta_analytical = (
        1.0 - hub_fill_rate
    ) * depot_fill_rate

    return {
        "hub_fill_rate": hub_fill_rate,
        "local_ebo": local_ebo,
        "theta_analytical": theta_analytical,
        "depot_fill_rate": depot_fill_rate,
        "depot_waiting_time": depot_waiting_time,
    }


# ============================================================
# Comparison
# ============================================================

def compare_simulation_with_supervisor(local_base_stock=2):
    parameters = {
        "mean_demand": [2.0, 3.0, 1.5],
        "lead_time_L": [2.0, 3.0, 2.5],
        "base_stock_s": [
            local_base_stock,
            14,
            7,
        ],
        "emerg_time": [0.5, 0.5, 0.5],
        "lead_time_L0": 5.0,
        "sim_duration": 200_000,
        "warmup": 50_000,
    }

    separator_length = 170

    print("\n" + "=" * separator_length)
    print(
        "Comparison for regional hub 1, "
        f"base-stock level = {local_base_stock}"
    )
    print("=" * separator_length)

    print(
        f"{'s0':>4}"
        f"{'Depot FR A':>12}"
        f"{'Hub FR A':>11}"
        f"{'Hub FR S':>11}"
        f"{'Hub OOS S':>11}"
        f"{'Depot avail S':>15}"
        f"{'P(depot|OOS)':>15}"
        f"{'Theta A':>12}"
        f"{'Theta S':>12}"
        f"{'Theta indep S':>16}"
        f"{'Error A-S':>12}"
    )

    print("-" * separator_length)

    for s0 in [
        15,
        20,
        25,
        30,
        35,
        40,
        45,
        50,
        55,
    ]:
        analytical = supervisor_analytical(
            local_base_stock=local_base_stock,
            s0=s0,
        )

        simulation = run_replications(
            n_reps=20,
            base_seed=1000,
            **{
                **parameters,
                "base_stock_s0": s0,
            },
        )

        theta_a = analytical["theta_analytical"]
        theta_s = simulation["theta_sim"][0]

        percentage_error = (
            100.0 * abs(theta_a - theta_s) / theta_a
            if theta_a > 0
            else 0.0
        )

        print(
            f"{s0:>4}"
            f"{analytical['depot_fill_rate']:>12.6f}"
            f"{analytical['hub_fill_rate']:>11.6f}"
            f"{simulation['shelf_fill_rate'][0]:>11.6f}"
            f"{simulation['hub_stockout_fraction'][0]:>11.6f}"
            f"{simulation['depot_availability_at_demand'][0]:>15.6f}"
            f"{simulation['conditional_depot_availability'][0]:>15.6f}"
            f"{theta_a:>12.6f}"
            f"{theta_s:>12.6f}"
            f"{simulation['theta_independence_sim'][0]:>16.6f}"
            f"{percentage_error:>11.2f}%"
        )


# ============================================================
# Run
# ============================================================

if __name__ == "__main__":
    compare_simulation_with_supervisor(
        local_base_stock=2
    )